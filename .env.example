# Secret-free local configuration. Capacity is a user declaration, not discovery.
LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
LLM_UNKNOWN_CONTEXT_POLICY=configured
# Required when the selected model has no declared context capacity.
# Set this to an appropriate limit for your deployment; no code default exists.
LLM_UNKNOWN_CONTEXT_TOKENS=32768
LLM_CONTEXT_POLICY=progressive
LLM_CONTEXT_COUNT_MODE=auto
# LLM_CONTEXT_TOKENS=<verified combined capacity>
# LLM_MAX_INPUT_TOKENS=<verified input limit>
IR1_SOURCE_TARGET_TOKENS=6000
CONTEXT_TEXT_OVERLAP_TOKENS=0
CONTEXT_MAX_SPLIT_DEPTH=32
# LLM_KNOWLEDGE_EXTRACTION_INPUT_TOKENS=24000
# LLM_RUN_MAX_GENERATION_CALLS=100
# LLM_RUN_MAX_RESERVED_TOKENS=1000000
# LLM_MAX_TOKENS_PER_MINUTE=100000

# Provider ceilings (defaults already raised for dense slide JSON):
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_SLIDE_COMPOSITION_OUTPUT_TOKENS=6144
# LLM_SLIDE_REPAIR_OUTPUT_TOKENS=6144
# LLM_MAX_CALLS_PER_MINUTE=30
MAX_REPAIRS_PER_SLIDE=3

# Set to true to enforce strict verbatim character-by-character substring checks on extracted evidence:
# VALIDATE_SUPPLIED_EVIDENCE=false
# Set to true to enforce strict localized fragment-level grounding aborts:
# VALIDATE_FRAGMENT_GROUNDING=false
# Strict section coverage now defaults to false: page headers, footnotes and
# flattened tables are excluded from coverage obligations, and gaps downgrade
# to warnings instead of failing the run. Set true to restore the old gate:
# STRICT_SECTION_COVERAGE=false

# Export the PPTX even when the deterministic quality gate reports hard failures
# (overlaps, out-of-bounds or measured overflow). Bypassed failures are logged as
# [WARN] Quality gate bypassed and recorded in quality_report.json warnings.
# FORCE_ACCEPT_QUALITY_ERRORS=false
